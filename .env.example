# Copie este arquivo para .env.local e preencha os valores.

# Postgres local: suba com `docker compose up -d`
DATABASE_URL=postgres://diva:diva@localhost:5432/diva

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Chave AES-256 dos prontuários e laudos (base64 de 32 bytes, 44 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca troque em produção sem migrar os dados criptografados.
CLINICAL_RECORDS_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
