# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# no Supabase (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app (usada nos links de confirmação de email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave AES-256 dos prontuários e laudos (base64 de 32 bytes, 44 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca troque em produção sem migrar os dados criptografados.
CLINICAL_RECORDS_ENCRYPTION_KEY=

# Segredo da tarefa diária que mantém o Supabase ativo (/api/keep-alive).
# Só precisa existir na Vercel. Gere com o mesmo comando acima.
CRON_SECRET=
